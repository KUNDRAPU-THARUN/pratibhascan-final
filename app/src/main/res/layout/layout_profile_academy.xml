<?xml version="1.0" encoding="utf-8"?>
<LinearLayout xmlns:android="http://schemas.android.com/apk/res/android"
    xmlns:app="http://schemas.android.com/apk/res-auto"
    android:id="@+id/layout_academy_profile_root"
    android:layout_width="match_parent"
    android:layout_height="wrap_content"
    android:orientation="vertical"
    android:visibility="gone">

    <!-- Academy Performance Analytics -->
    <LinearLayout
        android:layout_width="match_parent"
        android:layout_height="wrap_content"
        android:layout_marginTop="16dp"
        android:background="@drawable/bg_dashboard_card"
        android:orientation="vertical"
        android:padding="20dp">

        <TextView
            android:layout_width="wrap_content"
            android:layout_height="wrap_content"
            android:text="Talent Recruitment Analytics"
            android:textColor="@color/brand_blue"
            android:textSize="14sp"
            android:textStyle="bold" />

        <TextView
            android:layout_width="wrap_content"
            android:layout_height="wrap_content"
            android:text="Discovery rate &amp; conversion trends"
            android:textColor="#94A3B8"
            android:textSize="11sp" />

        <com.example.prathibhascanfinal.AnalyticsGraphView
            android:id="@+id/graph_academy_discovery"
            android:layout_width="match_parent"
            android:layout_height="120dp"
            android:layout_marginTop="16dp" />

        <LinearLayout
            android:layout_width="match_parent"
            android:layout_height="wrap_content"
            android:layout_marginTop="16dp"
            android:orientation="horizontal">
            <TextView android:layout_width="0dp" android:layout_weight="1" android:layout_height="wrap_content" android:text="Success: 74%" android:textColor="#10B981" android:textSize="12sp" android:textStyle="bold" />
            <TextView android:layout_width="0dp" android:layout_weight="1" android:layout_height="wrap_content" android:text="Active Roster: 45" android:textColor="@color/white" android:textSize="12sp" android:gravity="end" />
        </LinearLayout>
    </LinearLayout>

    <!-- Specialized Domains -->
    <LinearLayout
        android:layout_width="match_parent"
        android:layout_height="wrap_content"
        android:layout_marginTop="16dp"
        android:background="@drawable/bg_dashboard_card"
        android:orientation="vertical"
        android:padding="20dp">

        <TextView
            android:layout_width="wrap_content"
            android:layout_height="wrap_content"
            android:text="Specialized Domains"
            android:textColor="@color/brand_gold"
            android:textSize="14sp"
            android:textStyle="bold" />

        <com.google.android.material.chip.ChipGroup
            android:id="@+id/chip_group_domains"
            android:layout_width="match_parent"
            android:layout_height="wrap_content"
            android:layout_marginTop="12dp">
            <com.google.android.material.chip.Chip android:layout_width="wrap_content" android:layout_height="wrap_content" android:text="Cricket" app:chipBackgroundColor="#1E293B" android:textColor="@color/white" />
            <com.google.android.material.chip.Chip android:layout_width="wrap_content" android:layout_height="wrap_content" android:text="Athletics" app:chipBackgroundColor="#1E293B" android:textColor="@color/white" />
            <com.google.android.material.chip.Chip android:layout_width="wrap_content" android:layout_height="wrap_content" android:text="Bio-Mechanics" app:chipBackgroundColor="#1E293B" android:textColor="@color/white" />
        </com.google.android.material.chip.ChipGroup>
    </LinearLayout>

    <!-- Infrastructure Summary -->
    <LinearLayout
        android:layout_width="match_parent"
        android:layout_height="wrap_content"
        android:layout_marginTop="16dp"
        android:background="@drawable/bg_dashboard_card"
        android:orientation="vertical"
        android:padding="20dp">

        <TextView
            android:layout_width="wrap_content"
            android:layout_height="wrap_content"
            android:text="Facility Infrastructure"
            android:textColor="@color/white"
            android:textSize="14sp"
            android:textStyle="bold" />

        <TextView
            android:id="@+id/tv_infra_details"
            android:layout_width="match_parent"
            android:layout_height="wrap_content"
            android:layout_marginTop="8dp"
            android:text="• Full Size Cricket Ground\n• Indoor Gym &amp; Physio\n• 120 FPS High-Speed Cameras"
            android:textColor="#94A3B8"
            android:textSize="12sp"
            android:lineSpacingExtra="4dp" />
    </LinearLayout>

</LinearLayout>
