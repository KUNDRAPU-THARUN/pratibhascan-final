<?xml version="1.0" encoding="utf-8"?>
<LinearLayout xmlns:android="http://schemas.android.com/apk/res/android"
    xmlns:app="http://schemas.android.com/apk/res-auto"
    xmlns:tools="http://schemas.android.com/tools"
    android:layout_width="match_parent"
    android:layout_height="wrap_content"
    android:orientation="vertical"
    android:padding="@dimen/padding_medium"
    android:paddingBottom="48dp"
    android:clipToPadding="false">

    <TextView
        android:layout_width="wrap_content"
        android:layout_height="wrap_content"
        android:text="Official Rankings"
        android:textColor="@color/white"
        android:textSize="@dimen/text_size_headline_small"
        android:textStyle="bold" />

    <TextView
        android:layout_width="wrap_content"
        android:layout_height="wrap_content"
        android:layout_marginTop="4dp"
        android:text="Verified by Prathibha AI Integrity"
        android:textColor="@color/text_secondary"
        android:textSize="@dimen/text_size_body_small" />

    <!-- Tab Toggle (National / State) -->
    <LinearLayout
        android:layout_width="match_parent"
        android:layout_height="48dp"
        android:layout_marginTop="24dp"
        android:background="@drawable/bg_toggle_group"
        android:orientation="horizontal"
        android:padding="4dp">
        <TextView
            android:id="@+id/btn_toggle_national"
            android:layout_width="0dp"
            android:layout_height="match_parent"
            android:layout_weight="1"
            android:background="@drawable/bg_button_blue"
            android:gravity="center"
            android:text="NATIONAL"
            android:textColor="@color/white"
            android:textSize="12sp"
            android:textStyle="bold" />
        <TextView
            android:id="@+id/btn_toggle_state"
            android:layout_width="0dp"
            android:layout_height="match_parent"
            android:layout_weight="1"
            android:gravity="center"
            android:text="STATE"
            android:textColor="@color/text_secondary"
            android:textSize="12sp"
            android:textStyle="bold" />
    </LinearLayout>

    <!-- National Podium -->
    <androidx.constraintlayout.widget.ConstraintLayout
        android:layout_width="match_parent"
        android:layout_height="wrap_content"
        android:layout_marginTop="32dp">

        <!-- 1st Place (Center) -->
        <LinearLayout
            android:id="@+id/ll_first"
            android:layout_width="0dp"
            android:layout_height="wrap_content"
            android:gravity="center"
            android:orientation="vertical"
            app:layout_constraintBottom_toBottomOf="parent"
            app:layout_constraintEnd_toStartOf="@+id/ll_third"
            app:layout_constraintStart_toEndOf="@+id/ll_second"
            app:layout_constraintWidth_percent="0.34">
            <ImageView
                android:layout_width="64dp"
                android:layout_height="64dp"
                android:src="@android:drawable/ic_menu_myplaces"
                app:tint="@color/brand_gold"
                android:contentDescription="1st Place" />
            <View
                android:layout_width="match_parent"
                android:layout_height="100dp"
                android:layout_marginTop="8dp"
                android:background="@color/brand_gold" />
            <TextView
                android:layout_width="wrap_content"
                android:layout_height="wrap_content"
                android:translationY="-60dp"
                android:text="1st"
                android:textColor="@color/background_dark"
                android:textStyle="bold"
                android:textSize="16sp" />
        </LinearLayout>

        <!-- 2nd Place (Left) -->
        <LinearLayout
            android:id="@+id/ll_second"
            android:layout_width="0dp"
            android:layout_height="wrap_content"
            android:gravity="center"
            android:orientation="vertical"
            app:layout_constraintBottom_toBottomOf="parent"
            app:layout_constraintStart_toStartOf="parent"
            app:layout_constraintWidth_percent="0.3">
            <ImageView
                android:layout_width="50dp"
                android:layout_height="50dp"
                android:src="@android:drawable/ic_menu_myplaces"
                app:tint="#CBD5E1"
                android:contentDescription="2nd Place" />
            <View
                android:layout_width="match_parent"
                android:layout_height="70dp"
                android:layout_marginTop="8dp"
                android:background="#334155" />
            <TextView
                android:layout_width="wrap_content"
                android:layout_height="wrap_content"
                android:translationY="-40dp"
                android:text="2nd"
                android:textColor="@color/white"
                android:textStyle="bold" />
        </LinearLayout>

        <!-- 3rd Place (Right) -->
        <LinearLayout
            android:id="@+id/ll_third"
            android:layout_width="0dp"
            android:layout_height="wrap_content"
            android:gravity="center"
            android:orientation="vertical"
            app:layout_constraintBottom_toBottomOf="parent"
            app:layout_constraintEnd_toEndOf="parent"
            app:layout_constraintWidth_percent="0.3">
            <ImageView
                android:layout_width="45dp"
                android:layout_height="45dp"
                android:src="@android:drawable/ic_menu_myplaces"
                app:tint="#92400E"
                android:contentDescription="3rd Place" />
            <View
                android:layout_width="match_parent"
                android:layout_height="45dp"
                android:layout_marginTop="8dp"
                android:background="#78350F" />
            <TextView
                android:layout_width="wrap_content"
                android:layout_height="wrap_content"
                android:translationY="-25dp"
                android:text="3rd"
                android:textColor="@color/white"
                android:textStyle="bold" />
        </LinearLayout>

    </androidx.constraintlayout.widget.ConstraintLayout>

    <!-- Ranking List -->
    <androidx.recyclerview.widget.RecyclerView
        android:id="@+id/rv_leaderboard"
        android:layout_width="match_parent"
        android:layout_height="wrap_content"
        android:layout_marginTop="24dp"
        app:layoutManager="androidx.recyclerview.widget.LinearLayoutManager"
        tools:listitem="@layout/item_leaderboard_entry" />

</LinearLayout>
