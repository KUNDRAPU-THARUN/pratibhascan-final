<?xml version="1.0" encoding="utf-8"?>
<com.google.android.material.card.MaterialCardView xmlns:android="http://schemas.android.com/apk/res/android"
    xmlns:app="http://schemas.android.com/apk/res-auto"
    android:layout_width="match_parent"
    android:layout_height="wrap_content"
    android:layout_marginBottom="16dp"
    app:cardBackgroundColor="@color/card_bg_light"
    app:cardCornerRadius="16dp"
    app:strokeColor="@color/button_border"
    app:strokeWidth="1dp">

    <LinearLayout
        android:layout_width="match_parent"
        android:layout_height="wrap_content"
        android:orientation="vertical"
        android:padding="16dp">

        <androidx.constraintlayout.widget.ConstraintLayout
            android:layout_width="match_parent"
            android:layout_height="wrap_content">

            <TextView
                android:id="@+id/tv_sport_name"
                android:layout_width="0dp"
                android:layout_height="wrap_content"
                android:text="Sport Name"
                android:textColor="@color/white"
                android:textSize="18sp"
                android:textStyle="bold"
                app:layout_constraintStart_toStartOf="parent"
                app:layout_constraintTop_toTopOf="parent"
                app:layout_constraintEnd_toStartOf="@id/tv_sport_status" />

            <TextView
                android:id="@+id/tv_sport_category"
                android:layout_width="wrap_content"
                android:layout_height="wrap_content"
                android:text="Outdoor Sport"
                android:textColor="@color/text_secondary"
                android:textSize="12sp"
                app:layout_constraintStart_toStartOf="parent"
                app:layout_constraintTop_toBottomOf="@id/tv_sport_name" />

            <TextView
                android:id="@+id/tv_sport_status"
                android:layout_width="wrap_content"
                android:layout_height="wrap_content"
                android:background="@drawable/bg_chip_verified"
                android:paddingHorizontal="8dp"
                android:paddingVertical="2dp"
                android:text="Active"
                android:textColor="@color/brand_green"
                android:textSize="10sp"
                android:textStyle="bold"
                app:layout_constraintEnd_toEndOf="parent"
                app:layout_constraintTop_toTopOf="parent" />
        </androidx.constraintlayout.widget.ConstraintLayout>

        <LinearLayout
            android:layout_width="match_parent"
            android:layout_height="wrap_content"
            android:layout_marginTop="16dp"
            android:orientation="horizontal">

            <LinearLayout
                android:layout_width="0dp"
                android:layout_height="wrap_content"
                android:layout_weight="1"
                android:orientation="vertical">
                <TextView
                    android:layout_width="wrap_content"
                    android:layout_height="wrap_content"
                    android:text="Athletes"
                    android:textColor="@color/text_tertiary"
                    android:textSize="11sp" />
                <TextView
                    android:id="@+id/tv_count_athletes"
                    android:layout_width="wrap_content"
                    android:layout_height="wrap_content"
                    android:text="0"
                    android:textColor="@color/white"
                    android:textSize="16sp"
                    android:textStyle="bold" />
            </LinearLayout>

            <LinearLayout
                android:layout_width="0dp"
                android:layout_height="wrap_content"
                android:layout_weight="1"
                android:orientation="vertical">
                <TextView
                    android:layout_width="wrap_content"
                    android:layout_height="wrap_content"
                    android:text="Coaches"
                    android:textColor="@color/text_tertiary"
                    android:textSize="11sp" />
                <TextView
                    android:id="@+id/tv_count_coaches"
                    android:layout_width="wrap_content"
                    android:layout_height="wrap_content"
                    android:text="0"
                    android:textColor="@color/brand_gold"
                    android:textSize="16sp"
                    android:textStyle="bold" />
            </LinearLayout>
        </LinearLayout>

        <LinearLayout
            android:layout_width="match_parent"
            android:layout_height="wrap_content"
            android:layout_marginTop="16dp"
            android:orientation="horizontal">

            <com.google.android.material.button.MaterialButton
                android:id="@+id/btn_add_athlete_quick"
                style="@style/Widget.Material3.Button.TonalButton"
                android:layout_width="0dp"
                android:layout_height="wrap_content"
                android:layout_weight="1"
                android:text="Add Athlete"
                android:textSize="9sp"
                app:cornerRadius="8dp"
                android:paddingHorizontal="4dp" />

            <View android:layout_width="4dp" android:layout_height="0dp" />

            <com.google.android.material.button.MaterialButton
                android:id="@+id/btn_add_coach_quick"
                style="@style/Widget.Material3.Button.TonalButton"
                android:layout_width="0dp"
                android:layout_height="wrap_content"
                android:layout_weight="1"
                android:text="Add Coach"
                android:textSize="9sp"
                app:cornerRadius="8dp"
                android:paddingHorizontal="4dp" />

            <View android:layout_width="4dp" android:layout_height="0dp" />

            <com.google.android.material.button.MaterialButton
                android:id="@+id/btn_edit_sport_quick"
                style="@style/Widget.Material3.Button.TextButton"
                android:layout_width="wrap_content"
                android:layout_height="wrap_content"
                android:text="Edit"
                android:textSize="9sp"
                android:textColor="@color/brand_gold"
                android:minWidth="0dp"
                android:paddingHorizontal="4dp" />

            <com.google.android.material.button.MaterialButton
                android:id="@+id/btn_delete_sport_quick"
                style="@style/Widget.Material3.Button.TextButton"
                android:layout_width="wrap_content"
                android:layout_height="wrap_content"
                android:text="Delete"
                android:textSize="9sp"
                android:textColor="@color/brand_red"
                android:minWidth="0dp"
                android:paddingHorizontal="4dp" />

            <com.google.android.material.button.MaterialButton
                android:id="@+id/btn_view_details_quick"
                style="@style/Widget.Material3.Button.TextButton"
                android:layout_width="wrap_content"
                android:layout_height="wrap_content"
                android:text="Details"
                android:textSize="9sp"
                android:textColor="@color/brand_blue"
                android:minWidth="0dp"
                android:paddingHorizontal="4dp" />
        </LinearLayout>
    </LinearLayout>
</com.google.android.material.card.MaterialCardView>
