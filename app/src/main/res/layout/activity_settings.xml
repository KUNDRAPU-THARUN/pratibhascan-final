<?xml version="1.0" encoding="utf-8"?>
<androidx.constraintlayout.widget.ConstraintLayout xmlns:android="http://schemas.android.com/apk/res/android"
    xmlns:app="http://schemas.android.com/apk/res-auto"
    xmlns:tools="http://schemas.android.com/tools"
    android:layout_width="match_parent"
    android:layout_height="match_parent"
    android:background="@color/background_dark">

    <include
        layout="@layout/layout_global_header"
        android:id="@+id/layout_global_header"
        app:layout_constraintTop_toTopOf="parent" />

    <ScrollView
        android:layout_width="match_parent"
        android:layout_height="0dp"
        app:layout_constraintTop_toBottomOf="@id/layout_global_header"
        app:layout_constraintBottom_toBottomOf="parent">

        <LinearLayout
            android:layout_width="match_parent"
            android:layout_height="wrap_content"
            android:orientation="vertical"
            android:padding="20dp">

            <TextView style="@style/PortalTitleStyle" android:text="APP PREFERENCES" android:layout_marginBottom="12dp" />
            <com.google.android.material.card.MaterialCardView android:layout_width="match_parent" android:layout_height="wrap_content" app:cardBackgroundColor="@color/card_bg_light" app:cardCornerRadius="16dp">
                <LinearLayout android:layout_width="match_parent" android:layout_height="wrap_content" android:orientation="vertical" android:padding="8dp">
                    <TextView style="@style/SettingsItemStyle" android:text="Dark Mode (Always On)" android:drawableStart="@android:drawable/ic_menu_month" />
                    <View style="@style/SettingsDividerStyle" />
                    <TextView android:id="@+id/btn_set_language_new" style="@style/SettingsItemStyle" android:text="Language Settings" android:drawableStart="@android:drawable/ic_menu_search" />
                </LinearLayout>
            </com.google.android.material.card.MaterialCardView>

            <TextView style="@style/PortalTitleStyle" android:text="SECURITY" android:layout_marginTop="24dp" android:layout_marginBottom="12dp" />
            <com.google.android.material.card.MaterialCardView android:layout_width="match_parent" android:layout_height="wrap_content" app:cardBackgroundColor="@color/card_bg_light" app:cardCornerRadius="16dp">
                <LinearLayout android:layout_width="match_parent" android:layout_height="wrap_content" android:orientation="vertical" android:padding="8dp">
                    <TextView style="@style/SettingsItemStyle" android:text="Change Password" android:drawableStart="@android:drawable/ic_lock_idle_lock" />
                    <View style="@style/SettingsDividerStyle" />
                    <TextView style="@style/SettingsItemStyle" android:text="Privacy &amp; Data Sharing" android:drawableStart="@android:drawable/ic_menu_info_details" />
                </LinearLayout>
            </com.google.android.material.card.MaterialCardView>

            <TextView style="@style/PortalTitleStyle" android:text="SUPPORT &amp; LEGAL" android:layout_marginTop="24dp" android:layout_marginBottom="12dp" />
            <com.google.android.material.card.MaterialCardView android:layout_width="match_parent" android:layout_height="wrap_content" app:cardBackgroundColor="@color/card_bg_light" app:cardCornerRadius="16dp">
                <LinearLayout android:layout_width="match_parent" android:layout_height="wrap_content" android:orientation="vertical" android:padding="8dp">
                    <TextView style="@style/SettingsItemStyle" android:text="Help Center" android:drawableStart="@android:drawable/ic_menu_help" />
                    <View style="@style/SettingsDividerStyle" />
                    <TextView style="@style/SettingsItemStyle" android:text="Terms &amp; Conditions" android:drawableStart="@android:drawable/ic_menu_agenda" />
                    <View style="@style/SettingsDividerStyle" />
                    <TextView style="@style/SettingsItemStyle" android:text="Privacy Policy" android:drawableStart="@android:drawable/ic_menu_save" />
                </LinearLayout>
            </com.google.android.material.card.MaterialCardView>

            <TextView
                android:layout_width="wrap_content"
                android:layout_height="wrap_content"
                android:layout_gravity="center"
                android:layout_marginTop="32dp"
                android:text="App Version: 1.0.4-PRO"
                android:textColor="@color/text_secondary"
                android:textSize="11sp" />

        </LinearLayout>
    </ScrollView>

</androidx.constraintlayout.widget.ConstraintLayout>
