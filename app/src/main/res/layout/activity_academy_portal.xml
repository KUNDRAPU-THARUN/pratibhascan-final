<?xml version="1.0" encoding="utf-8"?>
<androidx.coordinatorlayout.widget.CoordinatorLayout xmlns:android="http://schemas.android.com/apk/res/android"
    xmlns:app="http://schemas.android.com/apk/res-auto"
    xmlns:tools="http://schemas.android.com/tools"
    android:id="@+id/academy_portal_root"
    android:layout_width="match_parent"
    android:layout_height="match_parent"
    android:background="@color/background_dark"
    tools:context=".AcademyPortalActivity">

    <com.google.android.material.appbar.AppBarLayout
        android:id="@+id/app_bar"
        android:layout_width="match_parent"
        android:layout_height="wrap_content"
        android:background="@android:color/transparent">
        <include layout="@layout/layout_global_header" android:id="@+id/layout_global_header" />
    </com.google.android.material.appbar.AppBarLayout>

    <androidx.core.widget.NestedScrollView
        android:id="@+id/nsv_content"
        android:layout_width="match_parent"
        android:layout_height="match_parent"
        android:clipToPadding="false"
        android:paddingBottom="80dp"
        app:layout_behavior="@string/appbar_scrolling_view_behavior">

        <LinearLayout
            android:layout_width="match_parent"
            android:layout_height="wrap_content"
            android:orientation="vertical"
            android:padding="16dp">

            <!-- 1. Academy Profile Header -->
            <com.google.android.material.card.MaterialCardView
                android:id="@+id/card_academy_profile"
                style="@style/M3CardStyle"
                android:layout_marginBottom="20dp"
                app:cardBackgroundColor="@color/card_bg">

                <androidx.constraintlayout.widget.ConstraintLayout
                    android:layout_width="match_parent"
                    android:layout_height="wrap_content"
                    android:padding="16dp">

                    <com.google.android.material.imageview.ShapeableImageView
                        android:id="@+id/iv_aca_logo"
                        android:layout_width="60dp"
                        android:layout_height="60dp"
                        android:scaleType="centerCrop"
                        android:src="@drawable/ic_academy_emblem"
                        app:layout_constraintStart_toStartOf="parent"
                        app:layout_constraintTop_toTopOf="parent"
                        app:shapeAppearanceOverlay="@style/ShapeAppearance.Material3.SmallComponent" />

                    <TextView
                        android:id="@+id/tv_aca_name_display"
                        android:layout_width="0dp"
                        android:layout_height="wrap_content"
                        android:layout_marginStart="16dp"
                        android:text="Academy Name"
                        android:textColor="@color/white"
                        android:textSize="20sp"
                        android:textStyle="bold"
                        app:layout_constraintEnd_toStartOf="@id/btn_edit_aca_profile"
                        app:layout_constraintStart_toEndOf="@id/iv_aca_logo"
                        app:layout_constraintTop_toTopOf="@id/iv_aca_logo" />

                    <TextView
                        android:id="@+id/tv_aca_type_location"
                        android:layout_width="0dp"
                        android:layout_height="wrap_content"
                        android:text="Private • City, State"
                        android:textColor="@color/text_secondary"
                        android:textSize="13sp"
                        app:layout_constraintEnd_toEndOf="@id/tv_aca_name_display"
                        app:layout_constraintStart_toStartOf="@id/tv_aca_name_display"
                        app:layout_constraintTop_toBottomOf="@id/tv_aca_name_display" />

                    <TextView
                        android:id="@+id/tv_aca_verification"
                        android:layout_width="wrap_content"
                        android:layout_height="wrap_content"
                        android:layout_marginTop="4dp"
                        android:text="Pending Verification"
                        android:textColor="@color/brand_gold"
                        android:textSize="11sp"
                        android:textStyle="bold"
                        app:layout_constraintStart_toStartOf="@id/tv_aca_type_location"
                        app:layout_constraintTop_toBottomOf="@id/tv_aca_type_location" />

                    <com.google.android.material.button.MaterialButton
                        android:id="@+id/btn_edit_aca_profile"
                        style="@style/Widget.Material3.Button.TextButton"
                        android:layout_width="wrap_content"
                        android:layout_height="wrap_content"
                        android:text="Edit"
                        android:textColor="@color/brand_blue"
                        app:layout_constraintBottom_toBottomOf="parent"
                        app:layout_constraintEnd_toEndOf="parent"
                        app:layout_constraintTop_toTopOf="parent" />

                </androidx.constraintlayout.widget.ConstraintLayout>
            </com.google.android.material.card.MaterialCardView>

            <!-- 2. Dashboard Statistics -->
            <TextView
                android:layout_width="wrap_content"
                android:layout_height="wrap_content"
                android:layout_marginBottom="12dp"
                android:text="Overview Statistics"
                android:textColor="@color/white"
                android:textSize="16sp"
                android:textStyle="bold" />

            <GridLayout
                android:id="@+id/grid_stats"
                android:layout_width="match_parent"
                android:layout_height="wrap_content"
                android:columnCount="2"
                android:layout_marginBottom="24dp">

                <include layout="@layout/item_dashboard_stat_card" android:id="@+id/stat_athletes" />
                <include layout="@layout/item_dashboard_stat_card" android:id="@+id/stat_coaches" />
                <include layout="@layout/item_dashboard_stat_card" android:id="@+id/stat_sports" />
                <include layout="@layout/item_dashboard_stat_card" android:id="@+id/stat_grounds" />
                <include layout="@layout/item_dashboard_stat_card" android:id="@+id/stat_revenue" />
                <include layout="@layout/item_dashboard_stat_card" android:id="@+id/stat_pending" />

            </GridLayout>

            <!-- 3. Sport-wise Summary -->
            <androidx.constraintlayout.widget.ConstraintLayout
                android:layout_width="match_parent"
                android:layout_height="wrap_content"
                android:layout_marginBottom="12dp">
                <TextView
                    android:layout_width="wrap_content"
                    android:layout_height="wrap_content"
                    android:text="Sports Offered"
                    android:textColor="@color/white"
                    android:textSize="16sp"
                    android:textStyle="bold"
                    app:layout_constraintStart_toStartOf="parent"
                    app:layout_constraintTop_toTopOf="parent"
                    app:layout_constraintBottom_toBottomOf="parent" />

                <com.google.android.material.button.MaterialButton
                    android:id="@+id/btn_add_new_sport"
                    style="@style/Widget.Material3.Button.TextButton"
                    android:layout_width="wrap_content"
                    android:layout_height="wrap_content"
                    android:text="+ Add New Sport"
                    android:textColor="@color/brand_blue"
                    android:textSize="12sp"
                    app:layout_constraintEnd_toEndOf="parent"
                    app:layout_constraintTop_toTopOf="parent"
                    app:layout_constraintBottom_toBottomOf="parent" />
            </androidx.constraintlayout.widget.ConstraintLayout>

            <LinearLayout
                android:id="@+id/layout_sport_summaries"
                android:layout_width="match_parent"
                android:layout_height="wrap_content"
                android:orientation="vertical"
                android:layout_marginBottom="24dp" />

            <!-- 4. Management Modules -->
            <TextView
                android:layout_width="wrap_content"
                android:layout_height="wrap_content"
                android:layout_marginBottom="12dp"
                android:text="Recent Registrations"
                android:textColor="@color/white"
                android:textSize="16sp"
                android:textStyle="bold" />

            <androidx.recyclerview.widget.RecyclerView
                android:id="@+id/rv_recent_registrations"
                android:layout_width="match_parent"
                android:layout_height="wrap_content"
                android:layout_marginBottom="24dp"
                android:nestedScrollingEnabled="false" />

            <!-- 5. Management Portal -->
            <TextView
                android:layout_width="wrap_content"
                android:layout_height="wrap_content"
                android:layout_marginBottom="12dp"
                android:text="Management Portal"
                android:textColor="@color/white"
                android:textSize="16sp"
                android:textStyle="bold" />

            <GridLayout
                android:id="@+id/grid_portal"
                android:layout_width="match_parent"
                android:layout_height="wrap_content"
                android:columnCount="1"
                android:paddingBottom="40dp">

                <!-- Management Buttons -->
                <include layout="@layout/item_portal_list_card" android:id="@+id/btn_talent_discovery" android:layout_width="match_parent" android:layout_height="wrap_content" />
                <include layout="@layout/item_portal_list_card" android:id="@+id/btn_athlete_mgmt" android:layout_width="match_parent" android:layout_height="wrap_content" />
                <include layout="@layout/item_portal_list_card" android:id="@+id/btn_coach_mgmt" android:layout_width="match_parent" android:layout_height="wrap_content" />
                <include layout="@layout/item_portal_list_card" android:id="@+id/btn_team_mgmt" android:layout_width="match_parent" android:layout_height="wrap_content" />
                <include layout="@layout/item_portal_list_card" android:id="@+id/btn_booking_mgmt" android:layout_width="match_parent" android:layout_height="wrap_content" />
                <include layout="@layout/item_portal_list_card" android:id="@+id/btn_inventory_mgmt" android:layout_width="match_parent" android:layout_height="wrap_content" />
                <include layout="@layout/item_portal_list_card" android:id="@+id/btn_attendance_mgmt" android:layout_width="match_parent" android:layout_height="wrap_content" />
                <include layout="@layout/item_portal_list_card" android:id="@+id/btn_tournament_mgmt" android:layout_width="match_parent" android:layout_height="wrap_content" />
                <include layout="@layout/item_portal_list_card" android:id="@+id/btn_ai_dashboard" android:layout_width="match_parent" android:layout_height="wrap_content" />
                <include layout="@layout/item_portal_list_card" android:id="@+id/btn_video_analysis" android:layout_width="match_parent" android:layout_height="wrap_content" />
                <include layout="@layout/item_portal_list_card" android:id="@+id/btn_medical_tracking" android:layout_width="match_parent" android:layout_height="wrap_content" />
                <include layout="@layout/item_portal_list_card" android:id="@+id/btn_nutrition_diet" android:layout_width="match_parent" android:layout_height="wrap_content" />
                <include layout="@layout/item_portal_list_card" android:id="@+id/btn_training_calendar" android:layout_width="match_parent" android:layout_height="wrap_content" />
                <include layout="@layout/item_portal_list_card" android:id="@+id/btn_payroll_mgmt" android:layout_width="match_parent" android:layout_height="wrap_content" />
                <include layout="@layout/item_portal_list_card" android:id="@+id/btn_record_transfer" android:layout_width="match_parent" android:layout_height="wrap_content" />
                <include layout="@layout/item_portal_list_card" android:id="@+id/btn_report_gen" android:layout_width="match_parent" android:layout_height="wrap_content" />

            </GridLayout>

        </LinearLayout>
    </androidx.core.widget.NestedScrollView>

    <!-- Loading Overlay -->
    <FrameLayout
        android:id="@+id/loading_overlay"
        android:layout_width="match_parent"
        android:layout_height="match_parent"
        android:background="#CC020617"
        android:visibility="gone">
        <ProgressBar
            android:layout_width="wrap_content"
            android:layout_height="wrap_content"
            android:layout_gravity="center"
            android:indeterminateTint="@color/brand_blue" />
    </FrameLayout>

</androidx.coordinatorlayout.widget.CoordinatorLayout>
