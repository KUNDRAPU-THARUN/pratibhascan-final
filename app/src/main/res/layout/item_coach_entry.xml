<?xml version="1.0" encoding="utf-8"?>
<LinearLayout xmlns:android="http://schemas.android.com/apk/res/android"
    xmlns:app="http://schemas.android.com/apk/res-auto"
    android:layout_width="match_parent"
    android:layout_height="wrap_content"
    android:orientation="vertical"
    android:layout_marginBottom="16dp"
    android:background="@drawable/bg_dashboard_card"
    android:padding="16dp">

    <TextView android:layout_width="wrap_content" android:layout_height="wrap_content" android:text="Coach Details" android:textColor="@color/brand_blue" android:textSize="12sp" android:textStyle="bold" />

    <EditText
        android:id="@+id/et_coach_name"
        android:layout_width="match_parent"
        android:layout_height="45dp"
        android:layout_marginTop="8dp"
        android:hint="Full Name"
        android:background="@drawable/bg_input_field"
        android:paddingHorizontal="12dp"
        android:textColor="@color/white"
        android:textSize="14sp"
        android:inputType="textCapWords" />

    <LinearLayout
        android:layout_width="match_parent"
        android:layout_height="wrap_content"
        android:orientation="horizontal"
        android:layout_marginTop="8dp">
        <EditText
            android:id="@+id/et_coach_email"
            android:layout_width="0dp"
            android:layout_height="45dp"
            android:layout_weight="1"
            android:layout_marginEnd="8dp"
            android:hint="Email"
            android:background="@drawable/bg_input_field"
            android:paddingHorizontal="12dp"
            android:textColor="@color/white"
            android:textSize="12sp"
            android:inputType="textEmailAddress" />
        <EditText
            android:id="@+id/et_coach_phone"
            android:layout_width="0dp"
            android:layout_height="45dp"
            android:layout_weight="1"
            android:hint="Phone"
            android:background="@drawable/bg_input_field"
            android:paddingHorizontal="12dp"
            android:textColor="@color/white"
            android:textSize="12sp"
            android:inputType="phone" />
    </LinearLayout>

    <LinearLayout
        android:layout_width="match_parent"
        android:layout_height="wrap_content"
        android:orientation="horizontal"
        android:layout_marginTop="8dp"
        android:gravity="center_vertical">
        <EditText
            android:id="@+id/et_coach_specialization"
            android:layout_width="0dp"
            android:layout_height="45dp"
            android:layout_weight="1"
            android:hint="Specialization (e.g. Cricket)"
            android:background="@drawable/bg_input_field"
            android:paddingHorizontal="12dp"
            android:textColor="@color/white"
            android:textSize="12sp"
            android:layout_marginEnd="8dp" />

        <Button
            android:id="@+id/btn_upload_coach_cert"
            android:layout_width="wrap_content"
            android:layout_height="45dp"
            android:text="CERT"
            android:textSize="11sp"
            android:textStyle="bold"
            android:backgroundTint="#1E293B"
            android:textColor="@color/brand_gold"
            app:icon="@android:drawable/ic_menu_camera"
            app:iconTint="@color/brand_gold"
            app:iconPadding="4dp" />
    </LinearLayout>

    <TextView
        android:id="@+id/tv_cert_status"
        android:layout_width="wrap_content"
        android:layout_height="wrap_content"
        android:layout_marginTop="4dp"
        android:text="No certificate attached"
        android:textColor="#475569"
        android:textSize="10sp"
        android:visibility="visible" />
</LinearLayout>
