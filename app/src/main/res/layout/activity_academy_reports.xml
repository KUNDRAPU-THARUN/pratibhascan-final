<?xml version="1.0" encoding="utf-8"?>
<androidx.constraintlayout.widget.ConstraintLayout xmlns:android="http://schemas.android.com/apk/res/android"
    xmlns:app="http://schemas.android.com/apk/res-auto"
    xmlns:tools="http://schemas.android.com/tools"
    android:layout_width="match_parent"
    android:layout_height="match_parent"
    android:background="@color/background_dark">

    <include
        layout="@layout/layout_global_header"
        android:id="@+id/layout_global_header"
        app:layout_constraintTop_toTopOf="parent" />

    <LinearLayout
        android:layout_width="match_parent"
        android:layout_height="0dp"
        android:orientation="vertical"
        android:padding="20dp"
        app:layout_constraintTop_toBottomOf="@id/layout_global_header"
        app:layout_constraintBottom_toBottomOf="parent">

        <TextView
            android:layout_width="wrap_content"
            android:layout_height="wrap_content"
            android:text="MANAGEMENT REPORTS"
            android:textColor="@color/white"
            android:textSize="18sp"
            android:textStyle="bold" />

        <TextView
            android:layout_width="wrap_content"
            android:layout_height="wrap_content"
            android:layout_marginTop="4dp"
            android:text="Download and share your academy data."
            android:textColor="@color/text_secondary"
            android:textSize="12sp" />

        <com.google.android.material.card.MaterialCardView
            android:layout_width="match_parent"
            android:layout_height="wrap_content"
            android:layout_marginTop="24dp"
            app:cardBackgroundColor="@color/card_bg_light"
            app:cardCornerRadius="20dp">
            <LinearLayout
                android:layout_width="match_parent"
                android:layout_height="wrap_content"
                android:orientation="vertical"
                android:padding="12dp">

                <TextView android:id="@+id/btn_athlete_report" style="@style/SettingsItemStyle" android:text="Athlete Performance Reports" android:drawableStart="@android:drawable/ic_menu_myplaces" android:clickable="true" android:focusable="true" android:foreground="?attr/selectableItemBackground" />
                <View style="@style/SettingsDividerStyle" />
                <TextView android:id="@+id/btn_coach_report" style="@style/SettingsItemStyle" android:text="Coach Attendance &amp; Payroll" android:drawableStart="@android:drawable/ic_menu_agenda" android:clickable="true" android:focusable="true" android:foreground="?attr/selectableItemBackground" />
                <View style="@style/SettingsDividerStyle" />
                <TextView android:id="@+id/btn_inventory_report" style="@style/SettingsItemStyle" android:text="Inventory &amp; Equipment Log" android:drawableStart="@android:drawable/ic_menu_save" android:clickable="true" android:focusable="true" android:foreground="?attr/selectableItemBackground" />
                <View style="@style/SettingsDividerStyle" />
                <TextView android:id="@+id/btn_financial_report" style="@style/SettingsItemStyle" android:text="Tournament Financial Report" android:drawableStart="@android:drawable/ic_menu_sort_by_size" android:clickable="true" android:focusable="true" android:foreground="?attr/selectableItemBackground" />
                <View style="@style/SettingsDividerStyle" />
                <TextView android:id="@+id/btn_ai_readiness_report" style="@style/SettingsItemStyle" android:text="AI Readiness &amp; Accuracy Score" android:drawableStart="@android:drawable/btn_star_big_on" android:clickable="true" android:focusable="true" android:foreground="?attr/selectableItemBackground" />

            </LinearLayout>
        </com.google.android.material.card.MaterialCardView>

        <com.google.android.material.button.MaterialButton
            android:id="@+id/btn_gen_all_reports"
            android:layout_width="match_parent"
            android:layout_height="56dp"
            android:layout_marginTop="32dp"
            android:text="GENERATE BULK PDF"
            android:textColor="@color/white"
            app:backgroundTint="@color/brand_blue"
            app:cornerRadius="12dp" />

    </LinearLayout>

</androidx.constraintlayout.widget.ConstraintLayout>
