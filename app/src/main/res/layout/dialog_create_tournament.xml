<?xml version="1.0" encoding="utf-8"?>
<LinearLayout xmlns:android="http://schemas.android.com/apk/res/android"
    xmlns:app="http://schemas.android.com/apk/res-auto"
    android:layout_width="match_parent"
    android:layout_height="wrap_content"
    android:orientation="vertical"
    android:padding="24dp"
    android:background="@color/card_bg">

    <TextView
        android:layout_width="wrap_content"
        android:layout_height="wrap_content"
        android:text="Create Tournament"
        android:textColor="@color/white"
        android:textSize="18sp"
        android:textStyle="bold" />

    <EditText
        android:id="@+id/et_tourney_title"
        android:layout_width="match_parent"
        android:layout_height="wrap_content"
        android:layout_marginTop="20dp"
        android:hint="Tournament Title"
        android:textColor="@color/white"
        android:textColorHint="@color/text_tertiary"
        android:backgroundTint="@color/brand_blue" />

    <EditText
        android:id="@+id/et_tourney_sport"
        android:layout_width="match_parent"
        android:layout_height="wrap_content"
        android:layout_marginTop="12dp"
        android:hint="Sport"
        android:textColor="@color/white"
        android:textColorHint="@color/text_tertiary"
        android:backgroundTint="@color/brand_blue" />

    <EditText
        android:id="@+id/et_tourney_venue"
        android:layout_width="match_parent"
        android:layout_height="wrap_content"
        android:layout_marginTop="12dp"
        android:hint="Venue"
        android:textColor="@color/white"
        android:textColorHint="@color/text_tertiary"
        android:backgroundTint="@color/brand_blue" />

    <EditText
        android:id="@+id/et_tourney_desc"
        android:layout_width="match_parent"
        android:layout_height="wrap_content"
        android:layout_marginTop="12dp"
        android:hint="Description (Optional)"
        android:textColor="@color/white"
        android:textColorHint="@color/text_tertiary"
        android:backgroundTint="@color/brand_blue" />

    <EditText
        android:id="@+id/et_tourney_fee"
        android:layout_width="match_parent"
        android:layout_height="wrap_content"
        android:layout_marginTop="12dp"
        android:hint="Entry Fee (e.g. ₹500 or Free)"
        android:textColor="@color/white"
        android:textColorHint="@color/text_tertiary"
        android:backgroundTint="@color/brand_blue" />

    <com.google.android.material.button.MaterialButton
        android:id="@+id/btn_confirm_create_tourney"
        android:layout_width="match_parent"
        android:layout_height="56dp"
        android:layout_marginTop="32dp"
        android:text="ORGANIZE TOURNAMENT"
        android:textColor="@color/white"
        android:textStyle="bold"
        app:cornerRadius="12dp"
        app:backgroundTint="@color/brand_blue" />

</LinearLayout>
