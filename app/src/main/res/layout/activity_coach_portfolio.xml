<?xml version="1.0" encoding="utf-8"?>
<androidx.constraintlayout.widget.ConstraintLayout xmlns:android="http://schemas.android.com/apk/res/android"
    xmlns:app="http://schemas.android.com/apk/res-auto"
    android:layout_width="match_parent"
    android:layout_height="match_parent"
    android:background="#020617"
    android:fitsSystemWindows="true">

    <ScrollView
        android:layout_width="match_parent"
        android:layout_height="match_parent"
        android:fillViewport="true">

        <LinearLayout
            android:layout_width="match_parent"
            android:layout_height="wrap_content"
            android:orientation="vertical"
            android:padding="24dp">

            <TextView
                android:layout_width="wrap_content"
                android:layout_height="wrap_content"
                android:text="@string/title_coach_portfolio"
                android:textColor="@color/white"
                android:textSize="24sp"
                android:textStyle="bold" />

            <TextView
                android:layout_width="wrap_content"
                android:layout_height="wrap_content"
                android:layout_marginTop="8dp"
                android:text="Showcase your biomechanical expertise to top academies."
                android:textColor="#94A3B8"
                android:textSize="14sp" />

            <!-- Specialization -->
            <com.google.android.material.textfield.TextInputLayout
                style="@style/Widget.Material3.TextInputLayout.OutlinedBox"
                android:layout_width="match_parent"
                android:layout_height="wrap_content"
                android:layout_marginTop="32dp"
                android:hint="Specialization (e.g. Cricket)"
                app:boxCornerRadiusTopStart="12dp"
                app:boxCornerRadiusTopEnd="12dp"
                app:boxCornerRadiusBottomStart="12dp"
                app:boxCornerRadiusBottomEnd="12dp"
                app:boxStrokeColor="@color/brand_blue"
                app:hintTextColor="@color/brand_blue">
                <com.google.android.material.textfield.TextInputEditText
                    android:id="@+id/et_coach_specialization"
                    android:layout_width="match_parent"
                    android:layout_height="wrap_content"
                    android:textColor="@color/white" />
            </com.google.android.material.textfield.TextInputLayout>

            <!-- Availability Card -->
            <LinearLayout
                android:layout_width="match_parent"
                android:layout_height="wrap_content"
                android:layout_marginTop="16dp"
                android:background="@drawable/bg_dashboard_card"
                android:gravity="center_vertical"
                android:orientation="horizontal"
                android:padding="20dp">
                <LinearLayout android:layout_width="0dp" android:layout_height="wrap_content" android:layout_weight="1" android:orientation="vertical">
                    <TextView android:layout_width="wrap_content" android:layout_height="wrap_content" android:text="@string/coach_availability" android:textColor="@color/white" android:textSize="14sp" android:textStyle="bold" />
                    <TextView android:id="@+id/tv_availability_status" android:layout_width="wrap_content" android:layout_height="wrap_content" android:text="@string/status_employed" android:textColor="#94A3B8" android:textSize="11sp" />
                </LinearLayout>
                <androidx.appcompat.widget.SwitchCompat
                    android:id="@+id/sw_availability"
                    android:layout_width="wrap_content"
                    android:layout_height="wrap_content"
                    app:thumbTint="@color/brand_blue"
                    app:trackTint="#1E293B" />
            </LinearLayout>

            <!-- Tech Skills Block -->
            <LinearLayout
                android:layout_width="match_parent"
                android:layout_height="wrap_content"
                android:layout_marginTop="20dp"
                android:background="@drawable/bg_dashboard_card"
                android:orientation="vertical"
                android:padding="20dp">

                <TextView android:layout_width="wrap_content" android:layout_height="wrap_content" android:text="@string/coach_tech_skills" android:textColor="@color/brand_blue" android:textSize="14sp" android:textStyle="bold" />

                <CheckBox android:id="@+id/cb_tech_video" android:layout_width="match_parent" android:layout_height="wrap_content" android:layout_marginTop="12dp" android:text="@string/tech_swingvision" android:textColor="@color/white" />
                <CheckBox android:id="@+id/cb_tech_dartfish" android:layout_width="match_parent" android:layout_height="wrap_content" android:text="@string/tech_dartfish" android:textColor="@color/white" />
                <CheckBox android:id="@+id/cb_tech_iot" android:layout_width="match_parent" android:layout_height="wrap_content" android:text="@string/tech_iot" android:textColor="@color/white" />
                <CheckBox android:id="@+id/cb_tech_mocap" android:layout_width="match_parent" android:layout_height="wrap_content" android:text="@string/tech_motion_cap" android:textColor="@color/white" />
            </LinearLayout>

            <!-- Media Portfolio -->
            <LinearLayout
                android:layout_width="match_parent"
                android:layout_height="wrap_content"
                android:layout_marginTop="20dp"
                android:background="@drawable/bg_dashboard_card"
                android:orientation="vertical"
                android:padding="20dp">

                <TextView android:layout_width="wrap_content" android:layout_height="wrap_content" android:text="@string/coach_video_portfolio" android:textColor="@color/brand_blue" android:textSize="14sp" android:textStyle="bold" />

                <TextView android:layout_width="wrap_content" android:layout_height="wrap_content" android:layout_marginTop="8dp" android:text="Upload a session showcasing form analysis or corrective drills." android:textColor="#94A3B8" android:textSize="11sp" />

                <Button
                    android:id="@+id/btn_upload_video"
                    android:layout_width="match_parent"
                    android:layout_height="56dp"
                    android:layout_marginTop="16dp"
                    android:backgroundTint="#1E293B"
                    android:text="Select Portfolio Video"
                    android:textAllCaps="false"
                    app:icon="@android:drawable/ic_menu_slideshow"
                    app:iconTint="@color/brand_gold" />

                <TextView android:id="@+id/tv_video_status" android:layout_width="wrap_content" android:layout_height="wrap_content" android:layout_marginTop="8dp" android:text="No video attached" android:textColor="#475569" android:textSize="10sp" />
            </LinearLayout>

            <Button
                android:id="@+id/btn_save_portfolio"
                android:layout_width="match_parent"
                android:layout_height="60dp"
                android:layout_marginTop="32dp"
                android:backgroundTint="@color/brand_blue"
                android:text="@string/btn_save_portfolio"
                android:textStyle="bold"
                app:cornerRadius="12dp" />

            <TextView
                android:id="@+id/btn_close_portfolio"
                android:layout_width="wrap_content"
                android:layout_height="wrap_content"
                android:layout_gravity="center"
                android:layout_marginTop="24dp"
                android:layout_marginBottom="32dp"
                android:text="← Return to Dashboard"
                android:textColor="#94A3B8"
                android:textSize="14sp" />

        </LinearLayout>
    </ScrollView>
</androidx.constraintlayout.widget.ConstraintLayout>
